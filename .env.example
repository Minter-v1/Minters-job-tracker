# Copy this file to .env.local and replace the values with the service owner's Supabase settings.
# Never commit .env.local. The secret key must only be read by trusted server-side code.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Server only: used by the approval endpoint to create/invite approved users.
# Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY
